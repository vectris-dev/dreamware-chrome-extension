{
  "manifest_version": 3,
  "name": "Dreamware Post Downloader",
  "version": "0.2.0",
  "description": "Downloads screenshots of X posts and original images/videos from Instagram posts.",
  "permissions": ["downloads"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["x.js"],
      "css": ["x.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["instagram.js"],
      "css": ["instagram.css"],
      "run_at": "document_idle"
    }
  ]
}
